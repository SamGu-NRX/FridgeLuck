{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fridgeluck.dev/community/schemas/error.schema.json",
  "title": "Error",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "description": "Machine-readable, e.g. declarations_missing, table_full, recipe_revised_offline, rate_limited, vote_too_early, quarantined_rights."
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
