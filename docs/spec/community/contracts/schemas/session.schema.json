{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fridgeluck.dev/community/schemas/session.schema.json",
  "title": "Session",
  "description": "Server-issued session (PR #104 mechanics, SPEC 7.1). Tokens are opaque to the client.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accessToken",
    "refreshToken",
    "account"
  ],
  "properties": {
    "accessToken": {
      "type": "string",
      "pattern": "^fla1\\.",
      "description": "HMAC-SHA256 access token, 15-minute TTL."
    },
    "refreshToken": {
      "type": "string",
      "pattern": "^flr1\\.",
      "description": "Single-use refresh token, 30-day TTL; reuse revokes the whole family."
    },
    "account": {
      "$ref": "https://fridgeluck.dev/community/schemas/account.schema.json"
    }
  }
}
