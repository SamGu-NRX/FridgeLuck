# Shared
PORT=8080
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_RECIPE_MODEL=gemini-2.5-flash
GEMINI_RANKING_MODEL=gemini-2.5-flash
LIVE_SESSION_STORE_MODE=auto
FIRESTORE_COLLECTION=liveSessions
GROUNDING_ENABLED=true

# Choose one auth mode:

# 1) Vertex AI mode (recommended for Cloud Run)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# 2) Developer API mode (local quick start)
# GOOGLE_GENAI_USE_VERTEXAI=false
# GEMINI_API_KEY=your-key

# Live session bounds (server-side authority; see README section 7)
# MAX_LIVE_SESSIONS=20
# MAX_SESSION_SECONDS=3600
# LIVE_CLIENT_MESSAGES_PER_MINUTE=300
# MUTATION_PROPOSAL_TTL_SECONDS=300

# Webhook OIDC authentication for /v1/webhooks/* (Cloud Scheduler / Cloud Tasks).
# When either value is missing or invalid the webhook routes fail closed (503).
# Audience must exactly match the OIDC audience configured on the scheduler.
WEBHOOK_OIDC_AUDIENCE=https://<your-service-url>/v1/webhooks/scheduler
# Comma-separated allowlist of service-account emails allowed to call the webhooks.
WEBHOOK_ALLOWED_EMAILS=scheduler@your-project.iam.gserviceaccount.com
