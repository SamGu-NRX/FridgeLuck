# gemini-agent environment — mirrors src/config.ts (loadConfig()).
# Copy to .env; dotenv loads it from this directory at startup.

# --- Server ---
# HTTP/WebSocket listen port. (default: 8080)
PORT=8080

# --- Gemini mode: exactly one must be satisfiable or startup fails ---
# Vertex AI mode: GOOGLE_GENAI_USE_VERTEXAI=true requires GOOGLE_CLOUD_PROJECT and
# GOOGLE_CLOUD_LOCATION (plus Application Default Credentials).
# Developer API mode: otherwise GEMINI_API_KEY is required.
# (default: false)
GOOGLE_GENAI_USE_VERTEXAI=false

# GCP project id. Required in Vertex mode; also makes LIVE_SESSION_STORE_MODE=auto
# resolve to Firestore. (no default)
#GOOGLE_CLOUD_PROJECT=your-project-id

# Vertex region. Required in Vertex mode. (default: us-central1)
#GOOGLE_CLOUD_LOCATION=us-central1

# Gemini API key for developer API mode. Required when GOOGLE_GENAI_USE_VERTEXAI
# is not true. (no default)
#GEMINI_API_KEY=your-key

# --- Gemini models ---
# Model for POST /v1/recipes/generate. (default: gemini-2.5-flash)
GEMINI_RECIPE_MODEL=gemini-2.5-flash

# Model for POST /v1/reverse-scan/rank. (default: gemini-2.5-flash)
GEMINI_RANKING_MODEL=gemini-2.5-flash

# Model bridged by WS /v1/live. Must be non-empty; deprecated Live model ids are
# rejected at startup. (default: gemini-2.5-flash-native-audio-preview-12-2025)
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# --- Live session store ---
# memory | firestore | auto. auto picks firestore when GOOGLE_CLOUD_PROJECT or
# FIRESTORE_EMULATOR_HOST is set, else memory. firestore mode requires one of
# those two variables. (default: auto)
LIVE_SESSION_STORE_MODE=auto

# Firestore collection for live-session documents. (default: liveSessions)
FIRESTORE_COLLECTION=liveSessions

# Point the Firestore SDK at an emulator (e.g. localhost:8080) for local runs;
# also satisfies firestore-mode configuration without a real project.
#FIRESTORE_EMULATOR_HOST=localhost:8080

# --- Restock / scheduler automation (webhooks) ---
# Days before expiry that triggers a "use soon" alert. (default: 3)
RESTOCK_THRESHOLD_DAYS=3

# Grams below which an inventory item lands on the restock list. (default: 50)
RESTOCK_BELOW_GRAMS=50

# Seconds an inventory-mutation idempotency key stays remembered. (default: 3600)
IDEMPOTENCY_TTL_SECONDS=3600

# --- Grounding ---
# Allow Google Search grounding for food-safety/freshness questions. (default: true)
GROUNDING_ENABLED=true
