  "steps": [
    {
      "text": "Fry half the onion rings in the oil in the skillet over medium-high for 8 minutes, stirring near the end, until they pass brown into deep mahogany. Drain on paper and salt them - these are the crown, so make them crisp.",
      "timer_min": 8
    },
    {
      "text": "Simmer the lentils in salted water to cover for 15 minutes, until tender but not falling apart. Drain.",
      "timer_min": 15
    },
    {
      "text": "In the saucepan, toast the rinsed rice with a pinch of salt in a slick of oil for a minute, add 2 cups of hot water, cover, and cook on the lowest heat for 15 minutes off the boil. Leave the lid on.",
      "timer_min": 15
    },
    {
      "text": "Boil the pasta in well-salted water for 8 minutes until soft with a trace of bite; drain.",
      "timer_min": 8
    },
    {
      "text": "Sauce: cook the remaining onion in a spoon of oil for 5 minutes, add the garlic, paste, cumin, and coriander and fry for 1 minute, then add the crushed tomatoes and chili flakes and simmer for 12 minutes. Finish with the vinegar and salt - it should be sharp and lightly sweet.",
      "timer_min": 18
    },
    {
      "text": "Warm the chickpeas through in the pot with a ladle of the sauce."
    },
    {
      "text": "Fold the lentils through the rice and mound the pasta over them in a wide platter. Pour the sauce around - not over - the stack, scatter the chickpeas, and finish with the fried onions."
    }
  ],
