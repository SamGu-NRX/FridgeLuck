  "steps": [
    {
      "text": "Soak the bread in a shallow bowl of water for 2 minutes, then squeeze it dry - it should be a damp paste, not a sponge.",
      "timer_min": 2
    },
    {
      "text": "Knead the beef, squeezed bread, grated onion, garlic, half the parsley, cumin, paprika, chili flakes, black pepper, and 2 teaspoons' worth of salt together with your hands for 2 minutes. The mix should feel sticky, not crumbly.",
      "timer_min": 2
    },
    {
      "text": "With wet hands, roll into 16 oblong kofte, each about the length of a thumb, and set them on a plate."
    },
    {
      "text": "Start the pilaf: rinse the rice until the water runs clear, drain, then melt the butter in the saucepan and toast the rice for 2 minutes, stirring, until it clicks and smells nutty.",
      "timer_min": 2
    },
    {
      "text": "Add 2 1/4 cups hot water and a pinch of salt, stir once, cover, and cook on the lowest heat for 15 minutes. Turn the heat off and leave the lid on.",
      "timer_min": 15
    },
    {
      "text": "Heat the oil in the skillet over medium-high. Cook the kofte in a single layer for 9 minutes, turning every few minutes, until they crust dark brown outside. Beef is safe at 160°F (71°C); check a thicker kofte with a thermometer.",
      "timer_min": 9,
      "safety": {
        "class": "meat_ground",
        "temp_f": 160,
        "method": "thermometer",
        "source": "USDA FSIS safe minimum internal temperature table"
      }
    },
    {
      "text": "Toss the tomatoes, cucumber, lemon juice, and the last of the salt together in the mixing bowl while the pan works."
    },
    {
      "text": "Fluff the pilaf with a fork and plate it with the kofte and the salad; drag the last of the parsley over everything."
    }
  ],
