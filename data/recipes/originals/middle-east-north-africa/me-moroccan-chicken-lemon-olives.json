  "steps": [
    {
      "text": "Season the chicken with half the salt and the black pepper. Brown it in the oil in the deep skillet over medium-high for 6 minutes, turning - the bits that stick will season the sauce. Move to a plate.",
      "timer_min": 6
    },
    {
      "text": "Cook the onion for 4 minutes, then add the garlic, cumin, turmeric, paprika, cinnamon, and chili flakes and fry for 1 minute, until fragrant.",
      "timer_min": 5
    },
    {
      "text": "Add the crushed tomatoes and stock and scrape the pan bottom clean. Nestle the chicken back in with any juices, cover, and simmer on medium-low for 8 minutes.",
      "timer_min": 8
    },
    {
      "text": "Add the chickpeas and olives and simmer, uncovered, for 6 minutes more to thicken the sauce.",
      "timer_min": 6
    },
    {
      "text": "Lift out a thick piece of chicken: it is safe at 165°F (74°C) on a thermometer, which it should reach in the simmered sauce.",
      "safety": {
        "class": "meat_poultry",
        "temp_f": 165,
        "method": "thermometer",
        "source": "USDA FSIS safe minimum internal temperature table"
      }
    },
    {
      "text": "Add the lemon juice, taste, and adjust: it should read salty from the olives and sour from the lemon before the spice catches up - balance with more juice or a pinch of salt."
    },
    {
      "text": "Shower with cilantro and serve in shallow bowls with rice or a green salad to round it out."
    }
  ],
