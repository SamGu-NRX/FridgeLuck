  "steps": [
    {
      "text": "Warm the oil in the saucepan over medium heat and cook the onion for 5 minutes, until translucent and starting to catch.",
      "timer_min": 5
    },
    {
      "text": "Add the green pepper and cook for 3 minutes more.",
      "timer_min": 3
    },
    {
      "text": "Stir in the tomato paste and crushed tomatoes and fry for 2 minutes, until the sauce darkens and smells sweet.",
      "timer_min": 2
    },
    {
      "text": "Add the bulgur, 2 cups of hot water, the salt, and the black pepper. Stir once, bring to a boil, then cover and cook on the lowest heat for 12 minutes. Do not stir again - the grains steam separately.",
      "timer_min": 12
    },
    {
      "text": "Take off the heat and rest, covered, for 5 minutes, then fork the pilaf loose and fold in the mint and chili flakes.",
      "timer_min": 5
    },
    {
      "text": "Serve warm or at room temperature; it packs for lunch as is, or top a bowl with a fried egg and call it dinner."
    }
  ],
