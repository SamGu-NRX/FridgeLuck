  "steps": [
    {
      "text": "Set the oven to 425°F. Whisk the oil, juice of two lemon halves, half the garlic, the cumin, paprika, turmeric, chili flakes, black pepper, and 2 teaspoons' worth of salt in the mixing bowl."
    },
    {
      "text": "Toss the chicken strips in the marinade to coat every surface and let them sit on the counter for 15 minutes while the oven heats.",
      "timer_min": 15
    },
    {
      "text": "Spread the chicken in one uncrowded layer on the sheet pan and drag the onion slices through the leftover marinade and onto the pan. Roast for 20 minutes total, turning once halfway, until the edges char in places.",
      "timer_min": 20
    },
    {
      "text": "Chicken is safe at 165°F (74°C); check the thickest strip with a thermometer before pulling the pan.",
      "safety": {
        "class": "meat_poultry",
        "temp_f": 165,
        "method": "thermometer",
        "source": "USDA FSIS safe minimum internal temperature table"
      }
    },
    {
      "text": "Stir the yogurt with the remaining garlic, the last lemon half, and the remaining salt into a sauce that sits thick on a spoon."
    },
    {
      "text": "Let the chicken rest on the pan for 5 minutes so the juices settle.",
      "timer_min": 5
    },
    {
      "text": "Toss the tomatoes and cucumber with a pinch of salt, then build plates: salad first, chicken and onions over it, yogurt sauce spooned alongside, pan juices drizzled over the top."
    },
    {
      "text": "Chill leftover chicken and sauce separately; the strips are also good cold from the box the next day."
    }
  ],
