  "steps": [
    {
      "text": "Stir the gochujang, soy sauce, honey, sesame oil, and garlic in a bowl into a smooth red sauce."
    },
    {
      "text": "Cook the onion in the vegetable oil in a skillet over medium-high for 3 minutes until the edges soften.",
      "timer_min": 3
    },
    {
      "text": "Add the kimchi and cook 2 minutes, scraping, until it stops bubbling hard and smells toasty.",
      "timer_min": 2
    },
    {
      "text": "Add the drained tuna in chunks, pour in the sauce, and fold 2 minutes over medium heat so the tuna warms through and drinks the sauce without shredding to paste.",
      "timer_min": 2
    },
    {
      "text": "Warm the rice in the microwave or in a dry skillet over the tuna pan's residual heat."
    },
    {
      "text": "Fry the eggs in the same skillet for 2 minutes, spooning the fat over the tops until the whites are set; they are safe at 160°F (71°C) - use pasteurized eggs if you want the yolks runny.",
      "timer_min": 2,
      "safety": {
        "class": "egg",
        "temp_f": 160,
        "method": "thermometer",
        "source": "USDA FSIS safe minimum internal temperature table"
      }
    },
    {
      "text": "Divide the warm rice between two bowls and spoon the tuna mixture over one side."
    },
    {
      "text": "Top each bowl with an egg, then the green onions and sesame seeds; mix at the table."
    }
  ],
