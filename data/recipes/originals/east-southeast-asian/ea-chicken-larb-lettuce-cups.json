  "steps": [
    {
      "text": "Toast the jasmine rice in a dry skillet over medium heat, shaking often, for 3 minutes until it smells like popcorn and turns golden in patches.",
      "timer_min": 3
    },
    {
      "text": "Crush the toasted rice to a coarse powder with a mortar and pestle (or a zip bag and a heavy pan). Keep it aside — this khao khua is the larb's nutty backbone."
    },
    {
      "text": "Stir the fish sauce and brown sugar together in a small bowl until the sugar dissolves."
    },
    {
      "text": "Heat the oil in the skillet over medium-high, add the garlic for 15 seconds, then add the chicken and break it up with a spatula."
    },
    {
      "text": "Cook the chicken for 6 minutes, stirring, until no pink remains and it has browned in spots. Ground chicken is safe at 165°F (74°C) — spot-check the thickest bits with a thermometer.",
      "timer_min": 6,
      "safety": {
        "class": "meat_poultry",
        "temp_f": 165,
        "method": "thermometer",
        "source": "USDA FSIS safe minimum internal temperature table"
      }
    },
    {
      "text": "Off the heat, pour the fish-sauce mixture over the chicken and toss so it steams into the meat."
    },
    {
      "text": "Let the chicken cool for 2 minutes — fresh herbs wilt instantly in a hot pan.",
      "timer_min": 2
    },
    {
      "text": "Fold in the shallot, herbs, green onions, chili flakes, then the lime juice and the toasted rice powder. Taste: it should hit sour first, then salty, then a little heat — adjust with more lime or fish sauce."
    },
    {
      "text": "Spoon into the lettuce leaves just before eating so they stay crisp; offer extra chili flakes on the table."
    }
  ],
