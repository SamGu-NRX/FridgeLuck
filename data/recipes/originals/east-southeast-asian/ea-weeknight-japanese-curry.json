  "steps": [
    {
      "text": "Start the rice; Japanese curry is ladled over a full bed of it."
    },
    {
      "text": "Cook the onions in the oil in a heavy pot over medium heat for 5 minutes, stirring, until they soften and gloss.",
      "timer_min": 5
    },
    {
      "text": "Add the garlic and ginger; stir 1 minute."
    },
    {
      "text": "Sprinkle the flour and curry powder over and stir a full minute to toast - this is the roux, and it needs the whole minute to lose the raw-flour taste.",
      "timer_min": 1
    },
    {
      "text": "Add the chicken pieces and toss 2 minutes to coat and seal the outsides.",
      "timer_min": 2
    },
    {
      "text": "Add the carrots, potatoes, and water, scraping the bottom; bring to a simmer, cover, and cook 15 minutes at a lazy bubble. Chicken is safe at 165°F (74°C) - check a thick piece.",
      "timer_min": 15,
      "safety": {
        "class": "meat_poultry",
        "temp_f": 165,
        "method": "thermometer",
        "source": "USDA FSIS safe minimum internal temperature table"
      }
    },
    {
      "text": "Stir in the honey and soy sauce and simmer 3 minutes uncovered until the sauce coats the back of a spoon - it should pour like heavy cream, not syrup.",
      "timer_min": 3
    },
    {
      "text": "Taste and adjust: another pinch of curry powder for warmth, or a splash of water if it thickened too far."
    },
    {
      "text": "Serve in deep plates over the rice with green onions scattered on top; the curry reheats even better the next day and freezes for a month."
    }
  ],
