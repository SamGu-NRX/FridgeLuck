  "steps": [
    {
      "text": "Whisk the soy sauce, vinegar, sugar, garlic, bay leaves, and pepper in a bowl. Add the thighs, turn to coat, and let them sit while you start the rice."
    },
    {
      "text": "Cook the jasmine rice by your usual method so it lands when the sauce reduces."
    },
    {
      "text": "Heat the oil in a deep skillet over medium-high. Lift the thighs out of the marinade (keep the marinade) and lay them in flat; sear 5 minutes without moving so the undersides color deeply.",
      "timer_min": 5
    },
    {
      "text": "Pour in the marinade and the water, scraping up anything stuck to the pan, and bring to a simmer."
    },
    {
      "text": "Cover, drop the heat to medium-low, and simmer 18 minutes, flipping the thighs halfway. Chicken is safe at 165°F (74°C) - check the thickest thigh with a thermometer.",
      "timer_min": 18,
      "safety": {
        "class": "meat_poultry",
        "temp_f": 165,
        "method": "thermometer",
        "source": "USDA FSIS safe minimum internal temperature table"
      }
    },
    {
      "text": "Uncover, raise the heat, and boil the sauce 4 minutes until it darkens and coats a spoon; tilt the pan and skim the fat off the top with a spoon.",
      "timer_min": 4
    },
    {
      "text": "Taste the sauce: sour should arrive first, then salt. If it tastes flat, fix it with a splash of vinegar, not more soy."
    },
    {
      "text": "Fluff the rice and divide among four plates; set two thighs on each and spoon plenty of sauce over."
    },
    {
      "text": "Scatter the green onions on top and serve - adobo reheats well, so keep any extra chicken in its sauce."
    }
  ],
