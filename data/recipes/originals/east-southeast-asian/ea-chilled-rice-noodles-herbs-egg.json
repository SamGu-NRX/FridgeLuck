  "steps": [
    {
      "text": "Cover the noodles with very hot tap water and soak 15 minutes, stirring once halfway, until pliable with a slight bite; drain and rinse under cold water.",
      "timer_min": 15
    },
    {
      "text": "Whisk the fish sauce, lime juice, sugar, garlic, chili, and the warm water in a small bowl until the sugar dissolves. Taste: sour should land first, then salt, then a little sweetness."
    },
    {
      "text": "Beat the eggs. Heat 1 teaspoon of the oil in a small nonstick skillet over medium, pour in a third of the egg, and tilt to coat the pan in a thin layer; cook about 2 minutes until the top looks matte. Eggs are safe at 160°F (71°C).",
      "timer_min": 2,
      "safety": {
        "class": "egg",
        "temp_f": 160,
        "method": "thermometer",
        "source": "USDA FSIS safe minimum internal temperature table"
      }
    },
    {
      "text": "Slide the omelet out and repeat with the remaining egg and oil, stacking the rounds on a cutting board; when cool, cut the stack into 1/2-inch ribbons."
    },
    {
      "text": "Toss the drained noodles with two-thirds of the dressing in a wide bowl until every strand is coated."
    },
    {
      "text": "Pile the cucumber, carrot, sprouts, cilantro, thai basil, and mint on top, then toss twice with your hands - the herbs should stay leafy, not bruised into the noodles."
    },
    {
      "text": "Add the egg ribbons and drizzle the rest of the dressing; toss once more."
    },
    {
      "text": "Divide between two bowls, top with peanuts and green onions, and eat cold - pass extra chili for heat seekers."
    }
  ],
