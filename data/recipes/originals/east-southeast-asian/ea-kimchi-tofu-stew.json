      "qty": {
        "kind": "household",
        "value": 2.5,
        "unit": "cup",
        "conversion_ref": "chicken_stock_cup",
        "grams_per_unit": 240,
        "note": "low-sodium; unsalted works best since gochujang and kimchi bring plenty"
      }
    },
    {
      "name": "gochujang",
      "qty": {
        "kind": "household",
        "value": 1,
        "unit": "tbsp",
        "conversion_ref": "gochujang_tbsp",
        "grams_per_unit": 16
      }
    },
