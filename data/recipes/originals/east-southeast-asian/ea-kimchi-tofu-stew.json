  "steps": [
    {
      "text": "Warm the sesame oil in a pot over medium heat; add the kimchi and garlic and cook 4 minutes, pressing the kimchi flat, until the edges caramelize and the pot smells sharp and sweet.",
      "timer_min": 4
    },
    {
      "text": "Stir in the gochujang and sugar; cook 30 seconds so they melt into the oil."
    },
    {
      "text": "Pour in the stock, scraping the bottom, and bring to a simmer, 3 minutes.",
      "timer_min": 3
    },
    {
      "text": "Add the tofu chunks and shiitake; simmer 8 minutes uncovered at a lazy bubble so the broth concentrates.",
      "timer_min": 8
    },
    {
      "text": "Taste the broth: it should be fiery, salty, and a little sour - balance it with a splash of the kimchi juice or a bit more stock."
    },
    {
      "text": "Turn the heat to medium-low so the stew bubbles gently, drizzle the beaten egg in a slow stream while stirring in one direction, and cook 1 minute; eggs are safe at 160°F (71°C) - if in doubt check with a thermometer, or use pasteurized eggs.",
      "timer_min": 1,
      "safety": {
        "class": "egg",
        "temp_f": 160,
        "method": "thermometer",
        "source": "USDA FSIS safe minimum internal temperature table"
      }
    },
    {
      "text": "Scatter the green onions on top and serve straight from the pot in deep bowls."
    }
  ],
