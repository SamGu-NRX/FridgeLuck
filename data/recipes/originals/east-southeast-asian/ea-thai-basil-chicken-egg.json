  "steps": [
    {
      "text": "Whisk the soy sauce, oyster sauce, fish sauce, and brown sugar in a small bowl until the sugar dissolves."
    },
    {
      "text": "Start the rice."
    },
    {
      "text": "Fry the eggs: heat 1 tablespoon of the oil in a small skillet over medium-high until it sizzles at the edges, slide in both eggs, and spoon the hot oil over them until the whites are set, about 2 minutes. They are safe at 160°F (71°C) - use pasteurized eggs if you want the yolks runny.",
      "timer_min": 2,
      "safety": {
        "class": "egg",
        "temp_f": 160,
        "method": "thermometer",
        "source": "USDA FSIS safe minimum internal temperature table"
      }
    },
    {
      "text": "Add the remaining oil to a wok over high heat, then the chilies, garlic, and shallot; stir-fry 1 minute until fragrant.",
      "timer_min": 1
    },
    {
      "text": "Add the ground chicken, press it flat against the pan, and let it sear 4 minutes without stirring.",
      "timer_min": 4
    },
    {
      "text": "Break the chicken up and stir-fry 3 minutes more; ground chicken is safe at 165°F (74°C) - check the center of the mass.",
      "timer_min": 3,
      "safety": {
        "class": "meat_poultry",
        "temp_f": 165,
        "method": "thermometer",
        "source": "USDA FSIS safe minimum internal temperature table"
      }
    },
    {
      "text": "Toss in the green beans and stir-fry 2 minutes; they should stay snappy.",
      "timer_min": 2
    },
    {
      "text": "Pour in the sauce and boil 1 minute, tossing, until it glazes everything.",
      "timer_min": 1
    },
    {
      "text": "Off the heat, fold in the torn basil so it wilts in the pan's heat, not the flame."
    },
    {
      "text": "Serve over rice with a crispy egg on each bowl."
    }
  ],
