  "steps": [
    {
      "n": 1,
      "text": "Blend the yogurt, mango, sugar, cardamom, and water about 60 seconds until the drink pours smooth and pale yellow — no mango threads left. Timer: 1 minute.",
      "timer_min": 1
    },
    {
      "n": 2,
      "text": "Taste: too thick? Beat in another splash of water. Not sweet enough? A little more sugar, then blend 10 seconds to dissolve it."
    },
    {
      "n": 3,
      "text": "Pour into two glasses and serve cold; it holds in the fridge for a day with a stir before drinking."
    }
