  "steps": [
    {
      "n": 1,
      "text": "Rinse the rice in three changes of water until the water runs clear, then soak it 15 minutes and drain well. Timer: 15 minutes.",
      "timer_min": 15
    },
    {
      "n": 2,
      "text": "Heat the oil in the pot over medium. Add the cumin seeds and wait for them to sputter, about 10 seconds; they should crackle, not sit quietly."
    },
    {
      "n": 3,
      "text": "Add the bay leaf, cardamom, cinnamon, cloves, and peppercorns; 15 seconds until they smell resinous."
    },
    {
      "n": 4,
      "text": "Add the onion and cook about 8 minutes, stirring, until it softens and turns a light copper at the edges. Timer: 8 minutes.",
      "timer_min": 8
    },
    {
      "n": 5,
      "text": "Add the garlic, ginger, and green chili; 1 minute until fragrant.",
      "timer_min": 1
    },
    {
      "n": 6,
      "text": "Add the chicken and turn the pieces in the aromatics about 3 minutes so every face loses its raw look.",
      "timer_min": 3
    },
    {
      "n": 7,
      "text": "Add the turmeric, the rice, and the salt; fold gently 1 minute so the grains toast without breaking."
    },
    {
      "n": 8,
      "text": "Pour in the water, level everything, and bring to a boil. Cover with the tight lid, drop to the lowest flame, and cook 12 minutes. No peeking — the steam is doing the work. Timer: 12 minutes.",
      "timer_min": 12
    },
    {
      "n": 9,
      "text": "Take the pot off heat and leave it sealed 10 minutes. Timer: 10 minutes.",
      "timer_min": 10
    },
    {
      "n": 10,
      "text": "Open, scatter the peas over the surface, re-cover, and let the residual heat wake them 2 minutes. Timer: 2 minutes.",
      "timer_min": 2
    },
    {
      "n": 11,
      "text": "Lift one of the largest chicken pieces and check it with a thermometer — 165°F (74°C) minimum at the thickest point.",
      "safety": {
        "class": "meat_poultry",
        "temp_f": 165,
        "method": "thermometer",
        "source": "USDA FSIS"
      }
    },
    {
      "n": 12,
      "text": "If the rice still resists under the lid, splash in 2 tbsp hot water and re-steam 5 minutes off heat. Fluff with the spoon edge, taste for salt, finish with cilantro."
    }
  ],
