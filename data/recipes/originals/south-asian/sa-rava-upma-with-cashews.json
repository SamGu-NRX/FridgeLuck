  "steps": [
    {
      "n": 1,
      "text": "Dry-roast the semolina in the saucepan over medium about 4 minutes, stirring without stopping, until it smells nutty and no longer tastes raw on a pinch. Move it to a bowl. Timer: 4 minutes.",
      "timer_min": 4
    },
    {
      "n": 2,
      "text": "Heat the oil in the same pan over medium. Add the mustard seeds and immediately cover — they pop hard. After 15 seconds add the cumin seeds."
    },
    {
      "n": 3,
      "text": "Add the cashews and cook about 1 minute, turning, until they pick up light spots.",
      "timer_min": 1
    },
    {
      "n": 4,
      "text": "Add the curry leaves (they spatter — stand back), green chilies, and ginger; 30 seconds until the kitchen smells like a tiffin counter."
    },
    {
      "n": 5,
      "text": "Add the onion and cook about 4 minutes until translucent and floppy. Timer: 4 minutes.",
      "timer_min": 4
    },
    {
      "n": 6,
      "text": "Add the carrot and peas; cook 2 minutes so they lose their raw chill.",
      "timer_min": 2
    },
    {
      "n": 7,
      "text": "Pour in the water with the salt and bring to a rolling boil."
    },
    {
      "n": 8,
      "text": "Lower the heat to a whisper and rain the semolina in with one hand while stirring hard with the other — this is the anti-lump move. When it's all in, keep stirring 1 minute as it swells."
    },
    {
      "n": 9,
      "text": "Cover and cook on the lowest flame 3 minutes so the grains finish through. Timer: 3 minutes.",
      "timer_min": 3
    },
    {
      "n": 10,
      "text": "Off the heat, fluff with a fork, squeeze the lemon juice over, and rest covered 2 minutes before serving. Timer: 2 minutes.",
      "timer_min": 2
    }
  ],
