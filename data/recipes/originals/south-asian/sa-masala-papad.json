  "steps": [
    {
      "n": 1,
      "text": "Roast the papads one at a time over a low open flame with tongs (or in a dry skillet over medium), about 20 seconds a side, until they blister and freckle without charring. Timer: 1 minute.",
      "timer_min": 1
    },
    {
      "n": 2,
      "text": "Set the papads on a rack to cool 1 minute — they crisp as they cool. Timer: 1 minute.",
      "timer_min": 1
    },
    {
      "n": 3,
      "text": "While they cool, toss the tomato, onion, green chili, cilantro, lemon juice, chaat masala, and cayenne together in a small bowl; taste — it should be bright and tart before the salty papad arrives."
    },
    {
      "n": 4,
      "text": "Spoon the relish over the papads only at the table, just before eating, so they stay crisp; no salt in the relish — the papad and chaat masala carry it."
    },
    {
      "n": 5,
      "text": "Break off pieces with your fingers and eat immediately, the way they're served in Pune's bars."
    }
  ],
