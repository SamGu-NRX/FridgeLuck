  "steps": [
    {
      "n": 1,
      "text": "Drain and rinse the chickpeas in a colander; shake them dry so the can liquor doesn't sharpen the gravy."
    },
    {
      "n": 2,
      "text": "Heat the oil in a wide skillet over medium. Cook the onion about 6 minutes, stirring so it darkens evenly, until the edges pick up color. Timer: 6 minutes.",
      "timer_min": 6
    },
    {
      "n": 3,
      "text": "Add the garlic, ginger, and green chili; cook 1 minute until fragrant.",
      "timer_min": 1
    },
    {
      "n": 4,
      "text": "Add the cumin, coriander, turmeric, and half the garam masala; stir constantly for 30 seconds so the spices bloom in the oil without scorching."
    },
    {
      "n": 5,
      "text": "Pour in the crushed tomatoes with half the salt. Cook 8 minutes, stirring now and then, until the sauce thickens enough to hold a spoon-track and the oil slicks at the edges. Timer: 8 minutes.",
      "timer_min": 8
    },
    {
      "n": 6,
      "text": "Stir in the chickpeas. Add a splash of water only if the pan looks past a thick curry consistency before they're coated."
    },
    {
      "n": 7,
      "text": "Cover and simmer gently 8 minutes so the chickpeas drink the gravy; stir once so nothing sticks. Timer: 8 minutes.",
      "timer_min": 8
    },
    {
      "n": 8,
      "text": "Press a chickpea against the pan wall with the spoon: it should crush easily."
    },
    {
      "n": 9,
      "text": "Off the heat, add the lemon juice and the remaining garam masala. Taste and add the rest of the salt only if it needs it."
    },
    {
      "n": 10,
      "text": "Let the pan rest off heat 5 minutes so the gravy gathers around the chickpeas, then finish with cilantro. Timer: 5 minutes.",
      "timer_min": 5
    }
  ],
