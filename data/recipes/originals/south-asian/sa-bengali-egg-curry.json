  "steps": [
    {
      "n": 1,
      "text": "Lower the eggs into a saucepan of cold water, bring to a boil, then hold at a lazy simmer 10 minutes. Eggs are safe at 160°F (71°C) on a thermometer; ten minutes at a simmer takes them well past that. Timer: 10 minutes.",
      "safety": {
        "class": "egg",
        "temp_f": 160,
        "method": "thermometer",
        "source": "USDA FSIS"
      },
      "timer_min": 10
    },
    {
      "n": 2,
      "text": "Drain and run the eggs under cold water; peel when cool enough to hold. Rub each with a pinch of the turmeric and a pinch of the salt."
    },
    {
      "n": 3,
      "text": "Heat the oil in a skillet over medium. Slide the eggs in and turn them for about 2 minutes until the surfaces blister and pick up a light crust; lift them out with a slotted spoon. Timer: 2 minutes.",
      "timer_min": 2
    },
    {
      "n": 4,
      "text": "In that oil, cook the onion about 6 minutes, scraping the brown bits, until it softens and deepens in color. Timer: 6 minutes.",
      "timer_min": 6
    },
    {
      "n": 5,
      "text": "Add the garlic, ginger, and green chilies; 1 minute until fragrant.",
      "timer_min": 1
    },
    {
      "n": 6,
      "text": "Add the cumin, coriander, remaining turmeric, and cayenne; stir 30 seconds."
    },
    {
      "n": 7,
      "text": "Add the tomatoes with the rest of the salt and cook about 6 minutes, mashing the pieces, until the masala thickens and the oil slicks at the edges. Timer: 6 minutes.",
      "timer_min": 6
    },
    {
      "n": 8,
      "text": "Pour in the water and bring to a simmer; the gravy should be loose enough to spoon. Slip the eggs in gently."
    },
    {
      "n": 9,
      "text": "Simmer 4 minutes so the eggs drink the gravy, spooning it over them once. Timer: 4 minutes.",
      "timer_min": 4
    },
    {
      "n": 10,
      "text": "Off the heat, finish with garam masala and cilantro; taste for salt before serving with rice or roti."
    }
  ],
