  "steps": [
    {
      "n": 1,
      "text": "Heat the oil in the skillet over medium-high. Add the potatoes in one layer and cook about 10 minutes, turning now and then, until spotty with crust. Move them to a bowl. Timer: 10 minutes.",
      "timer_min": 10
    },
    {
      "n": 2,
      "text": "Lower to medium. Add the cumin seeds; wait 10 seconds until they sputter and smell toasted."
    },
    {
      "n": 3,
      "text": "Add the onion and cook about 6 minutes until it softens and its edges pick up color. Timer: 6 minutes.",
      "timer_min": 6
    },
    {
      "n": 4,
      "text": "Add the garlic, ginger, and green chili; 1 minute until fragrant.",
      "timer_min": 1
    },
    {
      "n": 5,
      "text": "Add the ground cumin, coriander, turmeric, and cayenne; stir 30 seconds so the spices bloom without scorching."
    },
    {
      "n": 6,
      "text": "Add the tomato and cook about 4 minutes, mashing the pieces, until it collapses into a thick masala. Timer: 4 minutes.",
      "timer_min": 4
    },
    {
      "n": 7,
      "text": "Return the potatoes, add the cauliflower and the salt, and fold so the masala coats everything."
    },
    {
      "n": 8,
      "text": "Cover and cook on medium-low about 12 minutes, tossing once halfway, until the florets are tender at the stem when pierced. No water — the vegetables release their own steam. Timer: 12 minutes.",
      "timer_min": 12
    },
    {
      "n": 9,
      "text": "Off the heat, sprinkle the garam masala and cilantro; fold gently so the florets keep their shape."
    },
    {
      "n": 10,
      "text": "Taste for salt and serve hot with roti or rice."
    }
  ],
