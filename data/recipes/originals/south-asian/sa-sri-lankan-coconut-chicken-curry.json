  "steps": [
    {
      "n": 1,
      "text": "Rub the chicken with the coriander, turmeric, cayenne, and half the salt; set aside while you start the base (10 minutes is enough)."
    },
    {
      "n": 2,
      "text": "Heat the oil in the pot over medium. Add the curry leaves, cinnamon, and cardamom; stand back — the leaves spatter — and let them sizzle 30 seconds until the oil smells toasted and green."
    },
    {
      "n": 3,
      "text": "Add the onion and cook about 6 minutes, stirring, until it softens and turns light gold at the edges. Timer: 6 minutes.",
      "timer_min": 6
    },
    {
      "n": 4,
      "text": "Add the garlic, ginger, and green chilies; 1 minute until fragrant.",
      "timer_min": 1
    },
    {
      "n": 5,
      "text": "Add the chicken with all its rub and cook about 5 minutes, turning the pieces, until their outsides whiten and the spices toast. Timer: 5 minutes.",
      "timer_min": 5
    },
    {
      "n": 6,
      "text": "Pour in the coconut milk and water with the remaining salt, scraping the pot bottom; bring to a gentle simmer."
    },
    {
      "n": 7,
      "text": "Cover partially and simmer about 15 minutes, stirring once, until the curry thickens to a thin-gravy coat and the chicken is firm through. Timer: 15 minutes.",
      "timer_min": 15
    },
    {
      "n": 8,
      "text": "Check a large piece with a thermometer — 165°F (74°C) minimum at the thickest point.",
      "safety": {
        "class": "meat_poultry",
        "temp_f": 165,
        "method": "thermometer",
        "source": "USDA FSIS"
      }
    },
    {
      "n": 9,
      "text": "Off the heat, stir in the lime juice; rest 2 minutes so the coconut milk settles. Timer: 2 minutes.",
      "timer_min": 2
    },
    {
      "n": 10,
      "text": "Taste for salt and lime, pick out the cinnamon stick, and serve with rice or string hoppers."
    }
  ],
