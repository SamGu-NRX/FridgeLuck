  "steps": [
    {
      "n": 1,
      "text": "Heat the oil in a wide saute pan over medium-high. Add the onion and cook about 8 minutes until the edges deepen to a light copper. Timer: 8 minutes.",
      "timer_min": 8
    },
    {
      "n": 2,
      "text": "Add the garlic, ginger, and green chili; cook 1 minute until fragrant.",
      "timer_min": 1
    },
    {
      "n": 3,
      "text": "Add the potatoes and cook 3 minutes, turning them in the aromatics so every face gets some oil."
    },
    {
      "n": 4,
      "text": "Add the ground chicken, break it into small crumbles, and cook about 6 minutes, stirring often, until the raw color is gone and the crumbles tighten. Ground poultry is safe at 165°F (74°C) on a thermometer; you'll confirm it below.",
      "timer_min": 6
    },
    {
      "n": 5,
      "text": "Stir in the cumin, coriander, turmeric, cayenne, and all but a pinch of the salt; cook 30 seconds so the spices coat the meat."
    },
    {
      "n": 6,
      "text": "Add the crushed tomatoes, scrape the pan bottom, then cover and cook on medium-low about 12 minutes, stirring twice, until the potatoes are tender to a skewer tip. Timer: 12 minutes.",
      "timer_min": 12
    },
    {
      "n": 7,
      "text": "If the pan looks dry before the potatoes give, splash in 2 tbsp water and re-cover; the potatoes should sit in a thick masala, not soup."
    },
    {
      "n": 8,
      "text": "Check doneness: take the pan off heat and spot-check the thickest crumble with a thermometer — 165°F (74°C) minimum.",
      "safety": {
        "class": "meat_poultry",
        "temp_f": 165,
        "method": "thermometer",
        "source": "USDA FSIS"
      }
    },
    {
      "n": 9,
      "text": "Fold in the peas and garam masala; rest covered off heat 2 minutes so the peas thaw through in the steam. Timer: 2 minutes.",
      "timer_min": 2
    },
    {
      "n": 10,
      "text": "Taste for salt, scatter the cilantro, and serve with roti, rice, or a spoon straight from the pan."
    }
  ],
