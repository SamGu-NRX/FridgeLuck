  "steps": [
    {
      "text": "Heat the oven to 400°F and arrange a rack in the middle. Brush the tortillas on both sides with half the oil and lay them on a baking sheet."
    },
    {
      "text": "Bake the tortillas for 10 minutes, flipping once, until crisp and blistered at the edges. Hold them warm; they crisp further as they cool.",
      "timer_min": 10
    },
    {
      "text": "While the tortillas bake, heat the rest of the oil in a large skillet over medium heat. Cook the onion with a pinch of salt for 5 minutes, stirring a few times, until it softens and slumps.",
      "timer_min": 5
    },
    {
      "text": "Add the garlic, chipotle, oregano, and cumin. Stir for 30 seconds — the chipotle will sizzle and smell sharp and smoky."
    },
    {
      "text": "Pour in the tomatoes with their juice, add the bay leaf, and nestle in the chicken thighs. The sauce should barely cover them; press everything flat."
    },
    {
      "text": "Simmer gently for 15 minutes, half-covered, flipping the thighs once. Chicken thighs are safe at 165°F (74°C) — check the thickest piece on a thermometer.",
      "timer_min": 15,
      "safety": {
        "class": "meat_poultry",
        "temp_f": 165,
        "method": "thermometer",
        "source": "USDA FSIS safe minimum internal temperature table"
      }
    },
    {
      "text": "Lift the chicken out and shred it with two forks while the sauce bubbles hard, uncovered, for 3-4 minutes to thicken."
    },
    {
      "text": "Return the shredded chicken to the skillet and simmer 2 minutes so it drinks the sauce. Pull out the bay leaf and season with salt."
    },
    {
      "text": "Spread each crisp tortilla with tinga, then a drizzle of crema and crumbled queso fresco. Finish with cilantro and a squeeze of lime."
    }
  ],
  "cuisine_note": "Weeknight tinga skips the stock and the long braise: the thighs simmer straight in the tomato-chipotle sauce, which keeps enough liquid on its own.",
