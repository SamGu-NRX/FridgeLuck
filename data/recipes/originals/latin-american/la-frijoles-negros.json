  "steps": [
    {
      "text": "Start the rice: rinse it, cook it with 1 1/8 cups water, covered, over the lowest heat for 15 minutes, then leave it alone off the heat.",
      "timer_min": 15
    },
    {
      "text": "Warm the oil in the pot over medium heat. Cook the pepper and onion for 8 minutes, scraping the bottom, until the onion is translucent and sweet.",
      "timer_min": 8
    },
    {
      "text": "Add the garlic, cumin, and oregano and stir for 30 seconds — the cumin should smell toasted, not dusty."
    },
    {
      "text": "Add the beans, the water, the bay leaves, and half the salt. Raise the heat and bring to a simmer.",
      "timer_min": 2
    },
    {
      "text": "Simmer 15 minutes, uncovered, stirring now and then so the bottom does not catch. The beans should sit in a velvet gravy, not a broth.",
      "timer_min": 15
    },
    {
      "text": "Press about a quarter of the beans against the pot wall with your spoon and stir them in — this is how a Cuban potaje thickens itself without flour."
    },
    {
      "text": "Take the pot off the heat, pull the bay leaves, and stir in the vinegar. Season with the rest of the salt; beans drink salt slowly, so go by taste."
    },
    {
      "text": "Serve in shallow bowls over the rice. Leftovers freeze well for 3 months; thaw overnight and reheat to a full simmer, 165°F (74°C) in the center on a thermometer.",
      "reheat": true,
      "safety": {
        "class": "leftovers",
        "temp_f": 165,
        "method": "thermometer",
        "source": "USDA FSIS leftover reheating guidance"
      }
    }
  ],
  "cuisine_note": "Frijoles negros is the Cuban everyday potaje: a sofrito of pepper and onion, black beans thickened by mashing some of their own, and a splash of vinegar at the end to wake the pot up.",
