  "steps": [
    {
      "text": "Brown the beef hard in a dry pot over medium-high heat, breaking it into crumbles, for 6 minutes. Ground beef is safe at 160°F (71°C) - spot-check the thickest clump with a thermometer.",
      "timer_min": 6,
      "safety": {
        "class": "meat_ground",
        "temp_f": 160,
        "method": "thermometer",
        "source": "USDA FSIS safe minimum internal temperature table"
      }
    },
    {
      "text": "Stir in the onion and bell pepper and cook for 5 minutes, scraping the bottom, until they soften and the fond releases.",
      "timer_min": 5
    },
    {
      "text": "Add the garlic, smoked paprika, and chili flakes and stir for 30 seconds - paprika scorches fast, so keep it moving."
    },
    {
      "text": "Pour in the canned tomatoes, tomato puree, and water and bring the pot to a boil."
    },
    {
      "text": "Stir in the pasta, lower to a lively simmer, and cook uncovered for 11 minutes, stirring twice so the elbows don't stick to the bottom.",
      "timer_min": 11
    },
    {
      "text": "Season with the salt and pepper - the tomatoes carry salt already, so taste before the full teaspoon goes in."
    },
    {
      "text": "Rest the pot off the heat for 5 minutes; the sauce tightens as the pasta drinks.",
      "timer_min": 5
    },
    {
      "text": "Serve in deep bowls. Leftovers keep four days chilled and freeze well; reheat portions to 165°F (74°C) on a thermometer."
    }
  ],
