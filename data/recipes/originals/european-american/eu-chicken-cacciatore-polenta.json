  "steps": [
    {
      "text": "Season the chicken chunks with half the salt and the pepper. Heat the oil in a deep skillet over medium-high and brown them for 5 minutes, turning twice - color here is seasoning, not doneness.",
      "timer_min": 5
    },
    {
      "text": "Lift the chicken out. Cook the onion and bell pepper in the same pan for 5 minutes, then add the garlic and cook 30 seconds more.",
      "timer_min": 5
    },
    {
      "text": "Add the mushrooms and cook for 5 minutes, until they release their liquid and it boils away.",
      "timer_min": 5
    },
    {
      "text": "Pour in the canned tomatoes and tomato puree with the oregano and chili flakes, then nestle the chicken and any collected juices back in."
    },
    {
      "text": "Simmer gently, half covered, for 15 minutes - the chicken is safe at 165°F (74°C); check a thick chunk with a thermometer.",
      "timer_min": 15,
      "safety": {
        "class": "meat_poultry",
        "temp_f": 165,
        "method": "thermometer",
        "source": "USDA FSIS safe minimum internal temperature table"
      }
    },
    {
      "text": "While the cacciatore simmers, bring the water and milk to a simmer in a saucepan with the remaining salt and whisk the polenta in a slow stream."
    },
    {
      "text": "Cook the polenta at a bare simmer for 20 minutes, whisking often - it grabs the pot, so reach the bottom corners.",
      "timer_min": 20
    },
    {
      "text": "Taste the cacciatore for salt and pepper; swirl the parmesan into the polenta off the heat."
    },
    {
      "text": "Spoon the polenta into shallow bowls and ladle the cacciatore and its juices over the top."
    }
  ],
