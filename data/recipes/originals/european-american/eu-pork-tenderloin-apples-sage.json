  "steps": [
    {
      "text": "Trim the silver skin from the tenderloin and slice it into 8 thick medallions. Press each flat with your palm and season both sides with the salt and pepper."
    },
    {
      "text": "Heat the oil in a large skillet over medium-high and sear the medallions without moving them for 4 minutes, until the undersides are deep brown.",
      "timer_min": 4
    },
    {
      "text": "Turn and cook 3 minutes more. Pork whole cuts are safe at 145°F (63°C) with a short rest - check a thick medallion with a thermometer.",
      "timer_min": 3,
      "safety": {
        "class": "meat_whole_cut_pork",
        "temp_f": 145,
        "method": "thermometer",
        "source": "USDA FSIS safe minimum internal temperature table"
      }
    },
    {
      "text": "Move the pork to a plate and let it rest while the apples cook."
    },
    {
      "text": "Add the apple wedges to the empty skillet and toss for 4 minutes, until they soften at the edges and pick up the pan drippings.",
      "timer_min": 4
    },
    {
      "text": "Add the sage, water, and lemon juice and scrape the pan clean; simmer for 1 minute.",
      "timer_min": 1
    },
    {
      "text": "Return the medallions and any plate juices, turn them in the pan sauce for 30 seconds, and serve - spoon the apples alongside."
    }
  ],
