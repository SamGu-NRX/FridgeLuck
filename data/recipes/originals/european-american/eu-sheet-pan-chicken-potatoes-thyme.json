  "steps": [
    {
      "text": "Heat the oven to 425°F (220°C). On a rimmed sheet pan, toss the potatoes with 2 tablespoons of the oil, the garlic, thyme, and half the salt."
    },
    {
      "text": "Roast the potatoes alone for 15 minutes so they get a head start on the chicken.",
      "timer_min": 15
    },
    {
      "text": "Pull the pan out and push the potatoes to the edges. Rub the chicken with the last tablespoon of oil and the remaining salt and pepper, then set the pieces in the middle."
    },
    {
      "text": "Roast for 20 minutes, until the potatoes show browned edges and the chicken reads 165°F (74°C) at its thickest point on a thermometer.",
      "timer_min": 20,
      "safety": {
        "class": "meat_poultry",
        "temp_f": 165,
        "method": "thermometer",
        "source": "USDA FSIS safe minimum internal temperature table"
      }
    },
    {
      "text": "Rest the pan for 5 minutes, then squeeze the lemon juice over everything and scrape the pan juices across the potatoes.",
      "timer_min": 5
    }
  ],
