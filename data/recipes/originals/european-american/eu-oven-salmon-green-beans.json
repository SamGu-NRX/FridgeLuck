  "steps": [
    {
      "text": "Heat the oven to 425°F (220°C). On a sheet pan, toss the green beans with 1 tablespoon of the oil, the garlic, and a pinch of the salt."
    },
    {
      "text": "Roast the beans alone for 8 minutes so they blister while the salmon waits.",
      "timer_min": 8
    },
    {
      "text": "Push the beans to the edges, set the salmon fillets in the middle, and rub them with the rest of the oil, salt, and pepper."
    },
    {
      "text": "Roast for 10 minutes. Fish is safe at 145°F (63°C) - check the thickest fillet with a thermometer; it should flake at the edges and stay translucent at the center.",
      "timer_min": 10,
      "safety": {
        "class": "flesh_fish",
        "temp_f": 145,
        "method": "thermometer",
        "source": "USDA FSIS safe minimum internal temperature table"
      }
    },
    {
      "text": "Spoon the lemon juice over the fillets and beans and rest for 2 minutes before serving.",
      "timer_min": 2
    }
  ],
