{
  "version": 1,
  "cases": [
    {
      "id": "soy-sauce-vs-soy",
      "ingredient": "soy sauce",
      "restrictions": { "allergens": ["soy"] },
      "expected": { "result": "violated", "reasonContains": ["soy"] },
      "note": "soy sauce is brewed from soybeans"
    },
    {
      "id": "soy-sauce-vs-wheat",
      "ingredient": "soy sauce",
      "restrictions": { "allergens": ["wheat"] },
      "expected": { "result": "violated", "reasonContains": ["wheat"] },
      "note": "soy sauce is brewed with wheat"
    },
    {
      "id": "tamari-vs-soy",
      "ingredient": "tamari",
      "restrictions": { "allergens": ["soy"] },
      "expected": { "result": "violated", "reasonContains": ["soy"] },
      "note": "tamari is a soy product regardless of wheat status"
    },
    {
      "id": "tamari-vs-wheat",
      "ingredient": "tamari",
      "restrictions": { "allergens": ["wheat"] },
      "expected": { "result": "unknown", "missingMention": ["wheat"] },
      "note": "classic tamari is wheat-free but commercial products vary; no product evidence here"
    },
    {
      "id": "tamari-vs-glutenfree",
      "ingredient": "tamari",
      "restrictions": { "diets": ["glutenFree"] },
      "expected": { "result": "unknown", "missingMention": ["wheat"] },
      "note": "no product evidence: gluten-free status cannot be inferred"
    },
    {
      "id": "tamari-certified-gf-vs-glutenfree",
      "ingredient": "gluten-free tamari",
      "restrictions": { "diets": ["glutenFree"] },
      "expected": { "result": "allowed", "evidenceMention": ["label"] },
      "note": "the certified gluten-free product form carries label evidence"
    },
    {
      "id": "tamari-certified-gf-vs-soy",
      "ingredient": "gluten-free tamari",
      "restrictions": { "allergens": ["soy"] },
      "expected": { "result": "violated", "reasonContains": ["soy"] },
      "note": "certified gluten-free does not remove the soy allergen"
    },
    {
      "id": "tamari-certified-gf-vs-wheat",
      "ingredient": "gluten-free tamari",
      "restrictions": { "allergens": ["wheat"] },
      "expected": { "result": "unknown", "missingMention": ["wheat"] },
      "note": "a gluten-free label never establishes wheat absence (FDA 21 CFR 101.100): unknown, not allowed"
    },
    {
      "id": "gluten-free-bread-vs-wheat",
      "ingredient": "gluten-free bread",
      "restrictions": { "allergens": ["wheat"] },
      "expected": { "result": "violated", "reasonContains": ["wheat"] },
      "note": "exactly the FDA case: a declared wheat-derived component (wheat starch) violates wheat avoidance even in a gluten-free product"
    },
    {
      "id": "gluten-free-bread-vs-glutenfree",
      "ingredient": "gluten-free bread",
      "restrictions": { "diets": ["glutenFree"] },
